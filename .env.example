# Local settings only. Run python3 local/configure.py; never commit .env.
# Real Microsoft Entra sign-in is required, including for localhost.
ISA9000_COMPOSE_PROJECT_NAME=isa9000
ISA9000_WEB_PORT=8000
ISA9000_AZURITE_PORT=10000
ISA9000_POSTGRES_PORT=5432
# configure.py generates random values for these. Ports bind to 127.0.0.1.
ISA9000_DJANGO_SECRET_KEY=
ISA9000_CALLBACK_SECRET=
ISA9000_PAYLOAD_KEY=
ISA9000_ENTRA_TENANT_ID=
ISA9000_ENTRA_CLIENT_ID=
ISA9000_ENTRA_CLIENT_SECRET=
ISA9000_ADMIN_GROUP_ID=
# Register web redirect http://localhost:8000/auth/login/aad/callback.
# Enable SecurityGroup claims. Use the chosen ISA9000_WEB_PORT in the registration.
ISA9000_DAILY_RUNS_PER_USER=100
ISA9000_MAX_UPLOAD_MB=10
ISA9000_MAX_FILES=5
# Stub outcomes: 0 ready, 3 needs review, 1 failed. Recreate worker after changing.
ISA9000_STUB_EXIT=0
ISA9000_STUB_STEP_DELAY=1
# Real worker mode uses these. Real runs spend Foundry credit.
ISA9000_AZURE_OPENAI_ENDPOINT=
ISA9000_AZURE_OPENAI_API_KEY=
# Defaults use the free stub. Set the guarded worker command for real generation.
# ISA9000_CLI=python /app/tests/stub_isa9000.py
# ISA9000_CLI=python -m worker.cli
# Optional host TOML path, shared by web and worker; never put credentials in it.
# ISA9000_CONFIG_FILE=/absolute/path/to/isa9000.toml
# Emulator connections, database URL and console telemetry are local defaults.
# Authentication never falls back to demo mode when Entra is unavailable.
